{
  "name": "mini-harness",
  "version": "0.0.0",
  "private": true,
  "description": "学习用的 coding agent harness",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "start:debug": "node --inspect-wait src/main.ts",
    "explore:anthropic": "node scripts/explore-anthropic.ts",
    "explore:openai": "node scripts/explore-openai.ts",
    "replay": "node scripts/replay.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  }
}
