{
  "name": "mini-harness",
  "version": "0.0.0",
  "private": true,
  "description": "学习用的 coding agent harness",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "start:debug": "node --inspect-wait --env-file-if-exists=.env src/main.ts",
    "explore:anthropic": "node --env-file-if-exists=.env scripts/explore-anthropic.ts",
    "explore:openai": "node --env-file-if-exists=.env scripts/explore-openai.ts",
    "replay": "node scripts/replay.ts",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
