{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "观察 API 响应",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/explore-anthropic.ts",
      "args": [],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "观察 API 响应：带工具",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/explore-anthropic.ts",
      "args": [
        "--tool"
      ],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "回放当前打开的 .sse 文件",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/replay-anthropic.ts",
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "调试当前测试文件",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--test"
      ],
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "运行 agent",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.ts",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
