{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "观察 Anthropic 响应",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/explore-anthropic.ts",
      "args": [],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "观察 Anthropic 响应：带工具",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/explore-anthropic.ts",
      "args": [
        "--tool"
      ],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "观察 OpenAI 响应",
      "type": "node",
      "request": "launch",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/scripts/explore-openai.ts",
      "args": []
    },
    {
      "name": "观察 OpenAI 响应：带工具",
      "type": "node",
      "request": "launch",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "program": "${workspaceFolder}/scripts/explore-openai.ts",
      "args": [
        "--tool"
      ]
    },
    {
      "name": "回放当前打开的 .sse 文件",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/replay.ts",
      "args": [
        "${file}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "调试当前测试文件",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--test"
      ],
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "运行 agent",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.ts",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "附加到外部终端启动的 agent",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
