# 复制为 .env 后填写。.env 已被 git 忽略

# 用哪家：anthropic（默认）、openai 或 grok
# LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# 设为 off 关闭 Anthropic 的提示缓存，默认开启。OpenAI 格式的服务一般自动缓存，不受这个开关影响
# MH_PROMPT_CACHE=off

OPENAI_API_KEY=
# 能用哪些模型，运行 pnpm explore:openai --models 查看
OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium
# 接兼容 OpenAI 的其他服务时改这里
# OPENAI_BASE_URL=https://api.openai.com/v1

# grok 用 xAI 的接口（和 OpenAI 格式兼容）。两种认证方式：
# 1. 订阅账号：设置 GROK_OAUTH_CLIENT_ID 后运行 pnpm login:grok，在浏览器里授权，凭据存到 ~/.mini-harness/auth.json
# 2. 按量付费：设置 XAI_API_KEY，设置了就不用订阅凭据
# LLM_PROVIDER=grok
# pnpm login:grok 登录后会列出能用的模型
# GROK_MODEL=
# GROK_REASONING_EFFORT=high
# 登录用的 OAuth client id，需要是你有权使用的
# GROK_OAUTH_CLIENT_ID=
# XAI_API_KEY=
# 默认 https://api.x.ai/v1；改成别的地址时，凭据会发到那里
# GROK_BASE_URL=https://api.x.ai/v1

# 设为 1 时，agent 每次请求的原始流式响应都另存到 tmp/，可以用 pnpm replay 回放
# MH_SAVE_RAW=1

# 权限模式：auto（默认）或 bypass；启动参数 --mode 优先
# MH_PERMISSION_MODE=auto
# auto 模式下，除了工作目录和临时目录，bash 还可以写的目录，冒号分隔，可以用 ~
# MH_SANDBOX_WRITABLE=~/.npm:~/.cache
# auto 模式下禁止 bash 联网
# MH_SANDBOX_NETWORK=off

# 会话文件的存放目录，默认 ~/.mini-harness/sessions
# MH_SESSION_DIR=

# 默认从 ~/.mini-harness/skills 加载技能；额外目录用冒号分隔，可以用 ~
# MH_SKILL_DIRS=~/skills:/path/to/shared-skills

# 上下文估算超过这么多 token 时，发新问题前先压缩；压缩时保留最近大约这么多 token
# MH_COMPACT_AT=100000
# MH_COMPACT_KEEP=20000
