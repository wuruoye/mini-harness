# 复制为 .env 后填写。.env 已被 git 忽略

# 用哪家：anthropic（默认）、openai 或 grok
# LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# 设为 off 关闭 Anthropic 的提示缓存，默认开启。OpenAI 格式的服务一般自动缓存，不受这个开关影响
# MH_PROMPT_CACHE=off

OPENAI_API_KEY=
# 能用哪些模型，运行 pnpm explore:openai --models 查看
OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium
# 接兼容 OpenAI 的其他服务时改这里
# OPENAI_BASE_URL=https://api.openai.com/v1

# grok 复用 Grok Build 的订阅登录，先安装 CLI 并运行 grok login，不需要 API key
# LLM_PROVIDER=grok
# GROK_MODEL=grok-4.7
# GROK_REASONING_EFFORT=high
# 默认读取 ~/.grok/auth.json；支持 Grok CLI 的 GROK_HOME 和 GROK_AUTH_PATH
# GROK_AUTH_PATH=~/.grok/auth.json
# 有多个 xAI OAuth 登录时，填 auth.json 里要用的完整条目名
# GROK_AUTH_SCOPE=https://auth.x.ai::<client_id>
# CLI 不在默认安装位置或 PATH 时，指定程序路径
# GROK_BIN=/path/to/grok
# 通过自建代理转发时使用；订阅 token 会发送到这个地址
# GROK_BASE_URL=https://cli-chat-proxy.grok.com/v1

# 设为 1 时，agent 每次请求的原始流式响应都另存到 tmp/，可以用 pnpm replay 回放
# MH_SAVE_RAW=1

# 权限模式：auto（默认）或 bypass；启动参数 --mode 优先
# MH_PERMISSION_MODE=auto
# auto 模式下，除了工作目录和临时目录，bash 还可以写的目录，冒号分隔，可以用 ~
# MH_SANDBOX_WRITABLE=~/.npm:~/.cache
# auto 模式下禁止 bash 联网
# MH_SANDBOX_NETWORK=off

# 会话文件的存放目录，默认 ~/.mini-harness/sessions
# MH_SESSION_DIR=

# 默认从 ~/.mini-harness/skills 加载技能；额外目录用冒号分隔，可以用 ~
# MH_SKILL_DIRS=~/skills:/path/to/shared-skills

# 上下文估算超过这么多 token 时，发新问题前先压缩；压缩时保留最近大约这么多 token
# MH_COMPACT_AT=100000
# MH_COMPACT_KEEP=20000
