# 复制为 .env 后填写。.env 已被 git 忽略

# 用哪家：anthropic（默认）或 openai
# LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

OPENAI_API_KEY=
# 能用哪些模型，运行 pnpm explore:openai --models 查看
OPENAI_MODEL=gpt-5.5
# OPENAI_REASONING_EFFORT=medium
# 接兼容 OpenAI 的其他服务时改这里
# OPENAI_BASE_URL=https://api.openai.com/v1

# 设为 1 时，agent 每次请求的原始流式响应都另存到 tmp/，可以用 pnpm replay 回放
# MH_SAVE_RAW=1

# 权限模式：default（默认）、acceptEdits、auto、bypass；启动参数 --mode 优先
# MH_PERMISSION_MODE=default
